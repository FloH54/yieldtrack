<!DOCTYPE html>
<html lang="en">
<%- include('../partials/header')%>

<body id="page-top">
<div id="wrapper">
    <%- include('../partials/sidebar')%>

    <div id="content-wrapper" class="d-flex flex-column">
        <div id="content">
            <%- include('../partials/topbar')%>

            <div class="container-fluid">
                <%- include('../partials/dynamic_table')%>
            </div>
        </div>
        <%- include('../partials/footer')%>
    </div>
</div>

<%- include('../modals/logout')%>

<div class="modal fade" id="createCodeModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Create New Code</h5>
                <button class="close" type="button" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">×</span></button>
            </div>
            <form id="createCodeForm">
                <div class="modal-body">
                    <div class="form-group">
                        <label>Code Name</label>
                        <input type="text" class="form-control" name="codeName" required>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" type="button" data-dismiss="modal">Cancel</button>
                    <button class="btn btn-primary" type="submit">Create</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="editCodeModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit Code</h5>
                <button class="close" type="button" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">×</span></button>
            </div>
            <form id="editCodeForm">
                <div class="modal-body">
                    <input type="hidden" name="id" id="editCodeId">
                    <div class="form-group">
                        <label>Code Name</label>
                        <input type="text" class="form-control" name="codeName" id="editCodeName" required>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" type="button" data-dismiss="modal">Cancel</button>
                    <button class="btn btn-primary" type="submit">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteCodeModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Deletion</h5>
                <button class="close" type="button" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">×</span></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this block code? All tasks and remaining work entries linked to this code will have their code set to NULL.</p>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" type="button" data-dismiss="modal">Cancel</button>
                <button class="btn btn-danger" id="confirmDeleteCode">Delete</button>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function(){
        const prefs = <%- JSON.stringify(selectedColumns) %>;

        const columnsDefinition = [
            { data: 'codeId', name: 'codeId', title: 'ID' },
            { data: 'codeName', name: 'codeName', title: 'Code Name' },
            {
                data: null,
                name: 'actions',
                title: 'Actions',
                orderable: false,
                render: function(data, type, row) {
                    return `
                        <button class="btn btn-sm btn-warning btn-edit" data-id="${row.codeId}" data-name="${row.codeName}" data-toggle="modal" data-target="#editCodeModal"><i class="fas fa-edit"></i></button>
                        <button class="btn btn-sm btn-danger btn-delete" data-id="${row.codeId}" data-toggle="modal" data-target="#deleteCodeModal"><i class="fas fa-trash"></i></button>
                    `;
                }
            }
        ];

        initYieldtrackTable('<%= tableId %>', '/admin/api/admin/codes/data', columnsDefinition, prefs);

        // Events
        $('#<%= tableId %>').on('click', '.btn-edit', function() {
            $('#editCodeId').val($(this).data('id'));
            $('#editCodeName').val($(this).data('name'));
        });

        let deleteCodeId = null;
        $('#<%= tableId %>').on('click', '.btn-delete', function() {
            deleteCodeId = $(this).data('id');
        });

        // AJAX
        $('#createCodeForm').submit(function(e) {
            e.preventDefault();
            $.post('/admin/api/admin/codes', $(this).serialize(), function(res) {
                location.reload();
            }).fail(function(err) { alert(err.responseJSON?.error || "Error"); });
        });

        $('#editCodeForm').submit(function(e) {
            e.preventDefault();
            $.ajax({
                url: '/admin/api/admin/codes',
                type: 'PUT',
                data: $(this).serialize(),
                success: function(res) { location.reload(); },
                error: function(err) { alert(err.responseJSON?.error || "Error"); }
            });
        });

        $('#confirmDeleteCode').click(function() {
            if(deleteCodeId) {
                $.ajax({
                    url: '/admin/api/admin/codes',
                    type: 'DELETE',
                    data: { id: deleteCodeId },
                    success: function(res) { location.reload(); },
                    error: function(err) { alert(err.responseJSON?.error || "Error"); }
                });
            }
        });
    });
</script>
</body>
</html>
<!DOCTYPE html>
<html lang="en">
<%- include('../partials/header')%>
<body id="page-top">
<div id="wrapper">
    <%- include('../partials/sidebar')%>
    <div id="content-wrapper" class="d-flex flex-column">
        <div id="content">
            <%- include('../partials/topbar')%>
            <div class="container-fluid">
                <h1 class="h3 mb-4 text-gray-800">Work Package : <%- wp.wpName %></h1>
                <%- include('../partials/dynamic_table') %>
                <a href="/project/<%= projectSlug %>" class="btn btn-secondary mt-3"> Retour aux Work Packages</a>
            </div>
        </div>
        <%- include('../partials/footer')%>
    </div>
</div>

<%- include('../modals/logout') %>
<%- include('../modals/task.ejs') %>
<%- include('../modals/archive-task.ejs')%>
<%- include('../modals/edit-task.ejs')%>
<%- include('../modals/rw-history.ejs')%>
<script>
    $(document).ready(function() {
        const prefs = <%- JSON.stringify(selectedColumns) %>;
        let pendingRWUpdates = {};

        // Fonction utilitaire pour générer le HTML complet d'un Remaining Work
        function formatRWCell(rwData, isPending = false) {
            if (!rwData) return '<em class="text-muted">Aucune saisie</em>';

            const dateObj = new Date(rwData.rwDate);
            const dateStr = dateObj.toLocaleString('fr-FR', {
                day: '2-digit', month: '2-digit', year: 'numeric',
                hour: '2-digit', minute: '2-digit'
            });

            const codeStr = rwData.codeName ? `<span class="badge badge-info ml-1">${rwData.codeName}</span>` : '';
            const commentStr = rwData.comment ? `<br><small class="text-muted"><i class="fas fa-comment"></i> ${rwData.comment}</small>` : '';

            // Si c'est une saisie en attente (non validée), on change les couleurs
            const colorClass = isPending ? 'text-success' : 'text-primary';
            const pendingBadge = isPending ? '<span class="badge badge-warning ml-1">Non Validé</span>' : '';

            return `
                <div>
                    <span class="font-weight-bold ${colorClass}">${rwData.rwHours} h</span>
                    <small class="text-muted ml-1">${dateStr}</small>
                    ${codeStr} ${pendingBadge}
                    ${commentStr}
                </div>
            `;
        }

        const columnsDefinition = [
            { data: 'id', name: 'id', title: 'ID' },
            { data: 'workPackage.project.projectName', name: 'project', title: 'Project', defaultContent: "N/A" },
            { data: 'workPackage.wpName', name: 'wpName', title: 'Work Package', defaultContent: "N/A" },
            { data: 'taskName', name: 'taskName', title: 'Task Name' },
            { data: 'status.statName', name: 'status', title: 'Statut', defaultContent: "N/A" },
            { data: 'taskBudgetHours', name: 'budget', title: 'Budget (h)', defaultContent: "0" },

            {
                // COLONNE ACTIONS COMPLÈTE
                data: null, name: 'actions', title: 'Actions', orderable: false,
                render: function(data, type, row) {
                    // Sécurisation des données pour les attributs HTML
                    const safeName = row.taskName ? row.taskName.replace(/"/g, '&quot;') : '';
                    const start = row.taskStart ? row.taskStart.split('T')[0] : '';
                    const end = row.taskEnd ? row.taskEnd.split('T')[0] : '';

                    return `
                        <div class="d-flex align-items-center" style="gap: 8px">

                            <button class="btn btn-sm btn-secondary shadow-sm"
                                    data-toggle="modal" data-target="#rwHistoryModal"
                                    data-id="${row.id}" data-name="${safeName}" title="Historique RW">
                                <i class="fas fa-history"></i>
                            </button>

                            <button class="btn btn-sm btn-primary shadow-sm"
                                    data-toggle="modal" data-target="#editTaskModal"
                                    data-id="${row.id}"
                                    data-name="${safeName}"
                                    data-budget="${row.taskBudgetHours || ''}"
                                    data-start="${start}"
                                    data-end="${end}"
                                    data-status="${row.statId || ''}"  data-unit="${row.unitId || ''}"    title="Modifier la tâche">
                                <i class="fas fa-pen"></i>
                            </button>

                            <button class="btn btn-sm btn-danger shadow-sm"
                                    data-toggle="modal" data-target="#archiveTaskModal"
                                    data-id="${row.id}" data-name="${safeName}" title="Archiver la tâche">
                                <i class="fas fa-archive"></i>
                            </button>
                        </div>
                    `;
                }
            }
        ];

        initYieldtrackTable(
            '<%= tableId %>',
            '/project/<%= projectSlug %>/wp/<%= wp.slug %>/api/tasks', // <-- La bonne URL est ici
            columnsDefinition,
            prefs
        );

        // CHARGEMENT DE L'HISTORIQUE RW LORS DE L'OUVERTURE DE LA MODALE
        $('#rwHistoryModal').on('show.bs.modal', async function (event) {
            const button = $(event.relatedTarget);
            const taskId = button.data('id');
            const taskName = button.data('name');

            $('#hist-task-name').text(taskName);
            const tbody = $('#hist-table-body');

            // On affiche un loader en attendant la réponse du serveur
            tbody.html('<tr><td colspan="4" class="text-center py-4"><i class="fas fa-spinner fa-spin fa-2x text-primary"></i><p class="mt-2">Chargement...</p></td></tr>');

            try {
                // Appel à votre route définie dans taskRoutes.ts
                const response = await fetch(`/remaining/api/history/${taskId}`);
                const result = await response.json();

                if (response.ok && result.data && result.data.length > 0) {
                    tbody.empty();
                    result.data.forEach(rw => {
                        const dateObj = new Date(rw.rwDate);
                        const dateStr = dateObj.toLocaleString('fr-FR', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' });
                        const codeStr = rw.code ? `<span class="badge badge-info">${rw.code.codeName}</span>` : '-';
                        const commentStr = rw.comment ? rw.comment : '-';

                        tbody.append(`
                            <tr>
                                <td class="align-middle">${dateStr}</td>
                                <td class="align-middle"><span class="font-weight-bold text-primary">${rw.rwHours} h</span></td>
                                <td class="align-middle">${codeStr}</td>
                                <td class="align-middle">${commentStr}</td>
                            </tr>
                        `);
                    });
                } else {
                    tbody.html('<tr><td colspan="4" class="text-center text-muted py-4">Aucun historique de saisie pour le moment.</td></tr>');
                }
            } catch (error) {
                tbody.html('<tr><td colspan="4" class="text-center text-danger py-4">Erreur lors du chargement de l\'historique.</td></tr>');
            }
        });

        // OUVRE LA MODALE ET PRÉ-REMPLI LES INFOS
        $('#addRWModal').on('show.bs.modal', function (event) {
            const button = $(event.relatedTarget);
            $('#rw-task-id').val(button.data('id'));
            $('#rw-task-name').text(button.data('name'));

            $('#rw-hours').val('');
            $('#rw-code-id').val('');
            $('#rw-comment').val('');
        });
    });
</script>
</body>
</html>
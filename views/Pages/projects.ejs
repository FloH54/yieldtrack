<!DOCTYPE html>
<html lang="en">
<%- include('../partials/header')%>

<body id="page-top">
<div id="wrapper">
    <%- include('../partials/sidebar')%>

    <div id="content-wrapper" class="d-flex flex-column">
        <div id="content">
            <%- include('../partials/topbar')%>

            <div class="container-fluid">
                <%- include('../partials/dynamic_table')%>
            </div>
        </div>
        <%- include('../partials/footer')%>
    </div>
</div>

<%- include('../modals/logout')%>
<%- include('../modals/projects.ejs')%>
<%- include('../modals/edit-project.ejs')%>

<script>
    $(document).ready(function() {
        // Retrieving column preferences sent by the server
        const prefs = <%- JSON.stringify(selectedColumns) %>;

        // Definition of columns for DataTables (UPDATE)
        const columnsDefinition = [
            { data: 'id', name: 'id', title: 'ID' },
            { data: 'analyticalCode', name: 'analyticalCode', title: 'Analytical Code', defaultContent: 'N/A' },
            {
                data: 'name', name: 'name', title: 'Project Name',
                render: function(data, type, row) {
                    return `<a href="/project/${row.slug}">${data}</a>`;
                }
            },
            { data: 'type', name: 'type', title: 'Type', defaultContent: 'N/A' },
            { data: 'leaders', name: 'leaders', title: 'Program Leaders', defaultContent: 'None' },
            { data: 'slug', name: 'slug', title: 'Slug' },
            { data: 'start', name: 'start', title: 'Start Date', defaultContent: "N/A" },
            { data: 'end', name: 'end', title: 'End Date', defaultContent: "N/A" },
            {
                data: 'status', name: 'status', title: 'Status',
                render: function(data) {
                    if (!data) return "N/A";
                    const statusLower = data.toLowerCase();
                    if (statusLower === 'active') return '<span class="badge badge-success">Active</span>';
                    if (statusLower === 'completed' || statusLower === 'closed') return '<span class="badge badge-secondary">Close</span>';
                    return `<span class="badge badge-warning">${data}</span>`;
                }
            },
            {
                data: 'createdAt', name: 'createdAt', title: 'Created At',
                render: function(data) { return data ? new Date(data).toLocaleDateString() : "-"; }
            },
            {
                // Actions column
                data: null, name: 'actions', title: 'Actions', orderable: false,
                render: function(data, type, row) {
                    // Secure extraction of raw data for the modal
                    const typeId = row.rawType ? (row.rawType.projectTypeId || row.rawType.ProjectTypeId) : '';
                    const statId = row.rawStatus ? (row.rawStatus.StatId || row.rawStatus.statId) : '';
                    const leaderIds = (row.rawLeaders && row.rawLeaders.length > 0) ? row.rawLeaders.map(l => l.id).join(',') : '';
                    const safeName = row.projectName ? row.projectName.replace(/"/g, '&quot;') : '';
                    const start = row.start !== 'N/A' ? row.start : '';
                    const end = row.end !== 'N/A' ? row.end : '';

                    return `
                        <button class="btn btn-link btn-sm"
                                data-toggle="modal" data-target="#editProjectModal"
                                data-id="${row.id}"
                                data-name="${safeName}"
                                data-type="${typeId}"
                                data-status="${statId}"
                                data-leaders="${leaderIds}"
                                data-start="${start}"
                                data-end="${end}"
                                title="Edit">
                            <i class="fas fa-pen text-gray-400"></i>
                        </button>
                    `;
                }
            }
        ];

        // Initializing the table with the JSON API
        initYieldtrackTable('<%= tableId %>', '/project/api/data', columnsDefinition, prefs);
    });
</script>
</body>
</html>
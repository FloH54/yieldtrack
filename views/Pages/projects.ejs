<!DOCTYPE html>
<html lang="en">
<%- include('../partials/header')%>

<body id="page-top">
<div id="wrapper">
    <%- include('../partials/sidebar')%>

    <div id="content-wrapper" class="d-flex flex-column">
        <div id="content">
            <%- include('../partials/topbar')%>

            <div class="container-fluid">
                <%- include('../partials/dynamic_table')%>
            </div>
        </div>
        <%- include('../partials/footer')%>
    </div>
</div>

<%- include('../modals/logout')%>
<%- include('../modals/projects.ejs')%>
<%- include('../modals/edit-project.ejs')%>

<script>
    $(document).ready(function() {
        // Récupération des préférences de colonnes envoyées par le serveur
        const prefs = <%- JSON.stringify(selectedColumns) %>;

        // Définition des colonnes pour DataTables (MISE À JOUR)
        const columnsDefinition = [
            { data: 'id', name: 'id', title: 'ID' },
            {
                data: 'name', name: 'name', title: 'Project Name',
                render: function(data, type, row) {
                    return `<a href="/project/${row.slug}">${data}</a>`;
                }
            },
            { data: 'type', name: 'type', title: 'Type', defaultContent: 'N/A' },
            { data: 'leaders', name: 'leaders', title: 'Program Leaders', defaultContent: 'Aucun' },
            { data: 'slug', name: 'slug', title: 'Slug' },
            { data: 'start', name: 'start', title: 'Start Date', defaultContent: "N/A" },
            { data: 'end', name: 'end', title: 'End Date', defaultContent: "N/A" },
            {
                data: 'status', name: 'status', title: 'Status',
                render: function(data) {
                    if (!data) return "N/A";
                    const statusLower = data.toLowerCase();
                    if (statusLower === 'actif') return '<span class="badge badge-success">Actif</span>';
                    if (statusLower === 'completed' || statusLower === 'clôturé') return '<span class="badge badge-secondary">Clôturé</span>';
                    return `<span class="badge badge-warning">${data}</span>`;
                }
            },
            {
                data: 'createdAt', name: 'createdAt', title: 'Created At',
                render: function(data) { return data ? new Date(data).toLocaleDateString() : "-"; }
            },
            {
                // Colonne d'actions
                data: null, name: 'actions', title: 'Actions', orderable: false,
                render: function(data, type, row) {
                    // On passe l'objet `row` entier à la fonction de la modale d'édition
                    // L'échappement HTML est géré pour éviter de casser le JSON stringifié
                    const rowData = JSON.stringify(row).replace(/'/g, "&apos;").replace(/"/g, "&quot;");

                    return `
                        <button class="btn btn-link btn-sm" onclick="openEditProjectModal(${rowData})" title="Modifier">
                            <i class="fas fa-pen text-gray-400"></i>
                        </button>
                    `;
                }
            }
        ];

        // Initialisation du tableau avec l'API JSON
        initYieldtrackTable('<%= tableId %>', '/project/api/data', columnsDefinition, prefs);
    });
</script>
</body>
</html>
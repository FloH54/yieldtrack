<!DOCTYPE html>
<html lang="en">
<%- include('../partials/header')%>

<body id="page-top">
<div id="wrapper">
    <%- include('../partials/sidebar')%>

    <div id="content-wrapper" class="d-flex flex-column">
        <div id="content">
            <%- include('../partials/topbar')%>

            <div class="container-fluid">

                <%- include('../partials/dynamic_table')%>

                <div class="card shadow mb-4 mt-4">
                    <div class="card-header py-3">
                        <h4 class="m-0 font-weight-bold text-success">Tasks already assigned</h4>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-bordered" id="assignedTasksTable" width="100%" cellspacing="0">
                            </table>
                        </div>
                    </div>
                </div>

            </div>
        </div>
        <%- include('../partials/footer')%>
    </div>
</div>

<%- include('../modals/logout')%>
<%- include('../modals/create-unit')%>

<script>
    $(document).ready(function(){
        const prefs = <%- JSON.stringify(selectedColumns) %>;
        const allUsers = <%- JSON.stringify(allUsers) %>;

        // Definition of columns for DataTables
        const columnsDefinition = [
            { data: 'id', name: 'id', title: 'ID' },
            { data: 'workPackage.project.analyticalCode', name: 'analyticalCode', title: 'Analytical Code', defaultContent: "N/A" },
            { data: 'unit.unitName', name: 'name', title: 'Unit Name', defaultContent: "N/A" },
            { data: 'workPackage.project.projectName', name: 'project', title: 'Project', defaultContent: "N/A" },
            { data: 'workPackage.wpName', name: 'workPackage', title: 'Work Package', defaultContent: "N/A" },
            { data: 'taskName', name: 'taskName', title: 'Task Name' },
            { data: 'taskBudgetHours', name: 'budget', title: 'Budget (h)', defaultContent: "0" },

            // USER SELECT COLUMN
            {
                data: 'assigneeUserId',
                name: 'user',
                title: 'Assigned to',
                render: function(data, type, row) {
                    let select = `<select class="form-control select-assignee" data-taskid="${row.id}">`;

                    // The empty option allows to "unassign" the task and return it to the 1st table!
                    select += `<option value="">-- Not assigned --</option>`;

                    const taskUnitId = row.unitId;
                    const eligibleUsers = allUsers.filter(u => {
                        const userUnits = u.Units || u.units || [];
                        return userUnits.some(unit => unit.unitId === taskUnitId);
                    });

                    eligibleUsers.forEach(user => {
                        const isSelected = (user.id == data) ? 'selected' : '';
                        select += `<option value="${user.id}" ${isSelected}>${user.firstName} ${user.lastName}</option>`;
                    });

                    select += `</select>`;
                    return select;
                }
            },
            { data: 'priority', name: 'priority', title: 'Priority', defaultContent: "-" },
            { data: 'startDate', name: 'startDate', title: 'Start Date', defaultContent: "N/A" },
            { data: 'endDate', name: 'endDate', title: 'End Date', defaultContent: "N/A" }
        ];

        // INITIALIZATION OF THE TWO TABLES
        // 1. Default table (Unassigned)
        initYieldtrackTable('<%= tableId %>', '/units/api/data?status=unassigned', columnsDefinition, prefs);

        // 2. New table (Assigned)
        initYieldtrackTable('assignedTasksTable', '/units/api/data?status=assigned', columnsDefinition, prefs);
    });

    // Script to save the user change
    $(document).on('change', '.select-assignee', function() {
        const taskId = $(this).data('taskid');
        const userId = $(this).val();

        fetch('/units/update-assignee', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ taskId, userId })
        })
            .then(response => {
                if (response.ok) {
                    // We reload the TWO tables in the background to transfer the task
                    $('#<%= tableId %>').DataTable().ajax.reload(null, false);
                    $('#assignedTasksTable').DataTable().ajax.reload(null, false);
                } else {
                    alert("Error during assignment");
                }
            });
    });
</script>
</body>
</html>
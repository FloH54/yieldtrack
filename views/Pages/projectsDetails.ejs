<!DOCTYPE html>
<html lang="en">
<%- include('../partials/header')%>

<body id="page-top">
<div id="wrapper">
    <%- include('../partials/sidebar')%>

    <div id="content-wrapper" class="d-flex flex-column">
        <div id="content">
            <%- include('../partials/topbar')%>

            <div class="container-fluid">
                <h1 class="h3 mb-4 text-gray-800">Project : <%- project.projectName %></h1>

                <%- include('../partials/dynamic_table') %>

                <a href="/project" class="btn btn-secondary mt-3"> Back to projects</a>
            </div>
        </div>
        <%- include('../partials/footer')%>
    </div>
</div>

<%- include('../modals/logout') %>
<%- include('../modals/wp-selection') %>
<%- include('../modals/wp-template') %>
<%- include('../modals/wp-custom') %>
<%- include('../modals/edit-wp.ejs')%>

<script>
    $(document).ready(function() {
        const prefs = <%- JSON.stringify(selectedColumns) %>;

        const columnsDefinition = [
            { data: 'id', name: 'id', title: 'ID' },
            {
                data: 'wpName', name: 'name', title: 'WP Name',
                render: function(data, type, row) {
                    return `<a href="/project/<%= project.slug %>/wp/${row.slug}">${data}</a>`;
                }
            },
            { data: 'type.wpTypeName', name: 'type', title: 'Type', defaultContent: 'N/A' },
            { data: 'father.wpName', name: 'parent', title: 'Parent', defaultContent: '-' },
            { data: 'accountNumber', name: 'account', title: 'Account Number', defaultContent: "N/A" },
            { data: 'slug', name: 'slug', title: 'Slug' },
            {
                data: 'statId', name: 'status', title: 'Status',
                render: function(data) {
                    if (data === 1) return '<span class="badge badge-success">Actif</span>';
                    if (data === 4) return '<span class="badge badge-secondary">Clôturé</span>';
                    return `<span class="badge badge-warning">Statut ${data}</span>`;
                }
            },
            {
                data: null, name: 'actions', title: 'Actions', orderable: false,
                render: function(data, type, row) {
                    return `
                <button class="btn btn-link btn-sm" data-toggle="modal" data-target="#editWPModal"
                        data-id="${row.id}" data-name="${row.wpName}" data-slug="${row.slug}"
                        data-account="${row.accountNumber}" data-type="${row.wpTypeId}"
                        data-father="${row.fatherWPId || ''}" title="Edit">
                    <i class="fas fa-pen text-gray-400"></i>
                </button>
            `;
                }
            }
        ];

        initYieldtrackTable('<%= tableId %>', '/project/<%= project.slug %>/api/wps', columnsDefinition, prefs);
    });
</script>
</body>
</html>
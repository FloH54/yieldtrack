<!DOCTYPE html>
<html lang="en">
<%- include('../partials/header')%>

<body id="page-top">
<div id="wrapper">
    <%- include('../partials/sidebar')%>

    <div id="content-wrapper" class="d-flex flex-column">
        <div id="content">
            <%- include('../partials/topbar')%>

            <div class="container-fluid">
                <h1 class="h3 mb-4 text-gray-800">Change My Password</h1>

                <div class="row">
                    <div class="col-lg-6">
                        <div class="card shadow mb-4">
                            <div class="card-header py-3">
                                <h6 class="m-0 font-weight-bold text-primary">Security Modification</h6>
                            </div>
                            <div class="card-body">

                                <% if (typeof error !== 'undefined' && error) { %>
                                    <div class="alert alert-danger" role="alert">
                                        <i class="fas fa-exclamation-triangle mr-2"></i> <%= error %>
                                    </div>
                                <% } %>
                                <% if (typeof success !== 'undefined' && success) { %>
                                    <div class="alert alert-success" role="alert">
                                        <i class="fas fa-check-circle mr-2"></i> <%= success %>
                                    </div>
                                <% } %>

                                <form action="/change-password" method="POST">
                                    <div class="form-group">
                                        <label class="font-weight-bold text-gray-800">Current Password</label>
                                        <input type="password" name="currentPassword" class="form-control" required>
                                    </div>
                                    <div class="form-group">
                                        <label class="font-weight-bold text-gray-800">New Password</label>
                                        <input type="password" name="newPassword" class="form-control" required minlength="6">
                                    </div>
                                    <div class="form-group">
                                        <label class="font-weight-bold text-gray-800">Confirm New Password</label>
                                        <input type="password" name="confirmPassword" class="form-control" required minlength="6">
                                    </div>
                                    <hr>
                                    <button type="submit" class="btn btn-primary shadow-sm">
                                        <i class="fas fa-save mr-1"></i> Update Password
                                    </button>
                                </form>

                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
        <%- include('../partials/footer')%>
    </div>
</div>

<%- include('../modals/logout')%>

</body>
</html>
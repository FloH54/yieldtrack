<!DOCTYPE html>
<html lang="en">

<%- include('partials/header')%>
<body id="page-top">

    <!-- Page Wrapper -->
    <div id="wrapper">

        <%- include('partials/sidebar')%>

        <!-- Content Wrapper -->
        <div id="content-wrapper" class="d-flex flex-column">

            <!-- Main Content -->
            <div id="content">

            <%- include('partials/topbar')%>

                <!-- Begin Page Content -->
                <div class="container-fluid">

                    <% if(user.profiles && user.profiles.some(profiles => profiles.id === 1)) { %>
                        <div class="alert alert-info">
                            Bienvenue, Administrateur. Vous avez accès aux réglages système.
                        </div>
                        <li class="nav-item">
                            <a class="nav-link" href="/admin">
                                <i class="fas fa-fw fa-user-shield"></i>
                                <span>Panneau Admin</span>
                            </a>
                        </li>
                    <% } %>

                    <% if (user.profiles.includes('admin') || user.profiles.includes('manager')) { %>
                        <button class="btn btn-primary">Éditer le projet</button>
                    <% } %>

                    <!-- Content Row -->

                    <!-- Begin Page Content -->
                    <div class="container-fluid">
                    </div>
            </div>
            <!-- End of Main Content -->

        <%- include('partials/footer')%>


        </div>
        <!-- End of Content Wrapper -->

    </div>
    <!-- End of Page Wrapper -->

            <%- include('partials/modals')%>
    <!-- Scroll to Top Button-->
    <a class="scroll-to-top rounded" href="#page-top">
        <i class="fas fa-angle-up"></i>
    </a>
        </div>
    </div>
</body>
</html>
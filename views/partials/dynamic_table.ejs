<div class="card shadow mb-4">
    <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
        <h4 class="m-0 font-weight-bold text-primary"><%= tableTitle %></h4>

        <div class="d-flex align-items-center" style="gap: 10px;">
            <% if (typeof createAction !== 'undefined' && createAction) { %>
                <button class="btn btn-primary" data-toggle="modal" data-target="<%= createAction.modalTarget %>">
                    <i class="<%= createAction.icon %>"></i> <%= createAction.label %>
                </button>
            <% } %>

            <% if (typeof secondaryAction !== 'undefined' && secondaryAction) { %>
                <button class="btn <%= secondaryAction.btnClass || 'btn-secondary' %> shadow-sm" data-toggle="modal" data-target="<%= secondaryAction.modalTarget %>">
                    <i class="<%= secondaryAction.icon %>"></i> <%= secondaryAction.label %>
                </button>
            <% } %>

            <div class="dropdown no-arrow">
                <button class="btn btn-outline-secondary dropdown-toggle" type="button" id="dropdownColumns" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <i class="fas fa-columns"></i> Colonnes
                </button>
                <div class="dropdown-menu dropdown-menu-right shadow animated--fade-in p-3" aria-labelledby="dropdownColumns" onclick="event.stopPropagation()">
                    <form action="/preferences/columns" method="POST">
                        <input type="hidden" name="tableId" value="<%= tableId %>">
                        <input type="hidden" name="redirectUrl" value="<%= currentUrl %>">
                        <h6 class="dropdown-header px-0 text-uppercase font-weight-bold">Affichage :</h6>

                        <% allColumns.forEach(col => { %>
                            <div class="custom-control custom-checkbox mb-2">
                                <input type="checkbox" class="custom-control-input" name="columns"
                                       value="<%= col.id %>" id="col_<%= col.id %>"
                                        <%= selectedColumns.includes(col.id) ? 'checked' : '' %>>
                                <label class="custom-control-label" for="col_<%= col.id %>"><%= col.label %></label>
                            </div>
                        <% }); %>

                        <div class="dropdown-divider"></div>
                        <button type="submit" class="btn btn-primary btn-sm btn-block">Appliquer</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered" id="<%= tableId %>" width="100%" cellspacing="0">
            </table>
        </div>
    </div>
</div>
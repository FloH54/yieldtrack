<script>
    /**
     * Fonction universelle pour initialiser n'importe quel tableau YieldTrack
     */
    function initYieldtrackTable(tableId, apiUrl, columnsConfig, userPreferences) {
        // Applique les préférences de visibilité aux colonnes
        columnsConfig.forEach(col => {
            if (col.name && col.name !== 'actions' && userPreferences && userPreferences.length > 0) {
                col.visible = userPreferences.includes(col.name);
            }
        });

        $('#' + tableId).DataTable({
            ajax: { url: apiUrl, type: 'GET' },
            columns: columnsConfig,
            language: { emptyTable: "No data available in table" }
        });
    }

    $(document).ready(function() {
        $("#sidebarToggle, #sidebarToggleTop").on('click', function(e) {
            $(".sidebar").toggleClass("toggled");
            $("body").toggleClass("sidebar-toggled");
            if ($(".sidebar").hasClass("toggled")) {
                $('.sidebar .collapse').collapse('hide');
            };
        });
    });
</script>
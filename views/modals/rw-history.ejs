<div class="modal fade" id="rwHistoryModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">History: <span id="hist-task-name" class="text-primary font-weight-bold"></span></h5>
                <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="table-responsive">
                    <table class="table table-bordered table-striped" width="100%" cellspacing="0">
                        <thead class="thead-light">
                        <tr>
                            <th>Date</th>
                            <th>Hours (RW)</th>
                            <th>Cost Code</th>
                            <th>Comment</th>
                        </tr>
                        </thead>
                        <tbody id="hist-table-body">
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" type="button" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<script>
    // LOADING RW HISTORY IN THE MODAL
    $('#rwHistoryModal').on('show.bs.modal', async function (event) {
        const button = $(event.relatedTarget);
        const taskId = button.data('id');
        const tbody = $(this).find('tbody'); // We target the table in the modal

        tbody.html('<tr><td colspan="4" class="text-center"><i class="fas fa-spinner fa-spin"></i> Loading...</td></tr>');

        try {
            // Adapt the URL if your history route is slightly different
            const response = await fetch(`/remaining/api/history/${taskId}`);
            const result = await response.json();

            if (response.ok && result.data && result.data.length > 0) {
                let rows = '';
                result.data.forEach(rw => {
                    const dateStr = new Date(rw.rwDate).toLocaleString('en-US');
                    const codeStr = rw.code ? `<span class="badge badge-info">${rw.code.codeName}</span>` : '-';
                    rows += `<tr>
                            <td>${dateStr}</td>
                            <td class="font-weight-bold text-primary">${rw.rwHours} h</td>
                            <td>${codeStr}</td>
                            <td>${rw.comment || '-'}</td>
                        </tr>`;
                });
                tbody.html(rows);
            } else {
                tbody.html('<tr><td colspan="4" class="text-center text-muted">No history for this task.</td></tr>');
            }
        } catch (error) {
            tbody.html('<tr><td colspan="4" class="text-center text-danger">Error during loading.</td></tr>');
        }
    });
</script>
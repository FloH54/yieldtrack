<div class="modal fade" id="editProjectModal" tabindex="-1" aria-labelledby="editProjectModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editProjectModalLabel">Éditer le Projet</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editProjectForm">
                    <input type="hidden" id="editProjectId" name="id">

                    <div class="mb-3">
                        <label for="editProjectName" class="form-label">Nom du Projet</label>
                        <input type="text" class="form-control" id="editProjectName" name="projectName" required>
                    </div>

                    <div class="mb-3">
                        <label for="editProjectType" class="form-label">Type de Projet</label>
                        <select class="form-select" id="editProjectType" name="projectTypeId" required>
                            <% allTypes.forEach(type => { %>
                                <option value="<%= type.projectTypeId %>"><%= type.projectTypeName %></option>
                            <% }) %>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="editProjectLeaders" class="form-label">Program Leaders</label>
                        <select class="form-select" id="editProjectLeaders" name="leaderIds" multiple>
                            <% programLeaders.forEach(leader => { %>
                                <option value="<%= leader.id %>"><%= leader.firstName %> <%= leader.lastName %></option>
                            <% }) %>
                        </select>
                        <small class="text-muted">Maintenez Ctrl/Cmd pour sélectionner plusieurs leaders.</small>
                    </div>

                    <div class="mb-3">
                        <label for="editProjectStatus" class="form-label">Statut</label>
                        <select class="form-select" id="editProjectStatus" name="statId" required>
                            <% allStatus.forEach(stat => { %>
                                <option value="<%= stat.StatId || stat.id || stat.statId %>"><%= stat.StatName || stat.name %></option>
                            <% }) %>
                        </select>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="editStartDate" class="form-label">Date de début</label>
                            <input type="date" class="form-control" id="editStartDate" name="startDate">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="editEndDate" class="form-label">Date de fin</label>
                            <input type="date" class="form-control" id="editEndDate" name="endDate">
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                <button type="button" class="btn btn-primary" id="updateProjectBtn">Sauvegarder</button>
            </div>
        </div>
    </div>
</div>

<script>
    function openEditProjectModal(projectData) {
        document.getElementById('editProjectId').value = projectData.id;
        document.getElementById('editProjectName').value = projectData.projectName;

        // Remplissage du Type et du Statut
        if (projectData.type) document.getElementById('editProjectType').value = projectData.type.projectTypeId;
        if (projectData.status) document.getElementById('editProjectStatus').value = projectData.status.StatId;

        // Remplissage des Leaders (Select Multiple)
        const leaderSelect = document.getElementById('editProjectLeaders');
        const leaderIds = projectData.leaders ? projectData.leaders.map(l => l.id.toString()) : [];
        Array.from(leaderSelect.options).forEach(opt => {
            opt.selected = leaderIds.includes(opt.value);
        });

        // Dates
        document.getElementById('editStartDate').value = projectData.startDate ? projectData.startDate.split('T')[0] : '';
        document.getElementById('editEndDate').value = projectData.endDate ? projectData.endDate.split('T')[0] : '';

        const modal = new bootstrap.Modal(document.getElementById('editProjectModal'));
        modal.show();
    }

    document.getElementById('updateProjectBtn').addEventListener('click', async () => {
        const form = document.getElementById('editProjectForm');
        if (!form.checkValidity()) { form.reportValidity(); return; }

        const formData = new FormData(form);
        const data = Object.fromEntries(formData.entries());

        const leaderSelect = document.getElementById('editProjectLeaders');
        data.leaderIds = Array.from(leaderSelect.selectedOptions).map(opt => opt.value);

        try {
            const response = await fetch('/project/updtate', { // Remarque : J'ai gardé votre typo "updtate" issue des routes
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });

            const result = await response.json();
            if (response.ok) { window.location.reload(); }
            else { alert('Erreur: ' + result.error); }
        } catch (error) {
            alert('Erreur serveur.');
        }
    });
</script>
<div class="modal fade" id="editProjectModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog-centered modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Edit Project</h4>
                <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div id="edit-project-alert"></div>
            <form  id="editProjectForm" >
                <input type="hidden" name="id" id="edit_proj_id">
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6 form-group">
                            <h6>Project Name</h6>
                            <input type="text" name="projectName" id="edit_proj_name" class="form-control" required>
                        </div>
                    </div>
                    <div class="form-group">
                        <h6>Start Date</h6>
                        <input type="date" name="startDate" id="edit_proj_start" class="form-control">
                        <br>
                        <h6>End Date</h6>
                        <input type="date" name="endDate" id="edit_proj_end" class="form-control">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    // On cible le bon ID de formulaire : #editProjectForm
    $('#editProjectForm').on('submit', async function(e) {
        e.preventDefault();

        // On cible les bons IDs et on N'OUBLIE PAS L'ID DU PROJET CACHÉ
        const data = {
            id: $('#edit_proj_id').val(), // Indispensable pour l'update !
            projectName: $('#edit_proj_name').val(),
            startDate: $('#edit_proj_start').val(),
            endDate: $('#edit_proj_end').val()
            // Ajoutez managerId et statId ici si vous les avez rajoutés dans le HTML de cette modale
        };

        const submitBtn = $(this).find('button[type="submit"]');
        submitBtn.prop('disabled', true).text('Saving...');

        try {
            const response = await fetch('/project/updtate', { // "updtate" correspond bien à la faute de frappe dans vos routes
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });

            const result = await response.json();

            if (response.ok) {
                // Pour l'édition, on recharge juste la page pour voir les modifications
                window.location.reload();
            } else {
                alert("Error: " + (result.error || "Unknown error occurred."));
                submitBtn.prop('disabled', false).text('Save Changes');
            }
        } catch (err) {
            console.error(err);
            alert("Network error or Server unreachable.");
            submitBtn.prop('disabled', false).text('Save Changes');
        }
    });
</script>
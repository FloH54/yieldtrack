<div class="modal fade" id="editTaskModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog-centered modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Edit Task</h4>
                <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div id="edit-task-alert"></div>
            <form action="/task/update" id="editTaskForm" method="POST">
                <input type="hidden" name="id" id="edit_task_id">
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6 form-group">
                            <h6>Task Name</h6>
                            <input type="text" name="taskName" id="edit_task_name" class="form-control" required>
                        </div>
                        <div class="col-md-6 form-group">
                            <h6>Budget (in hours)</h6>
                            <input type="number" name="budget" id="edit_task_budget" class="form-control" required>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 form-group">
                            <h6>Start Date</h6>
                            <input type="date" name="startDate" id="edit_task_start" class="form-control">
                        </div>
                        <div class="col-md-6 form-group">
                            <h6>End Date</h6>
                            <input type="date" name="endDate" id="edit_task_end" class="form-control">
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    $(document).ready(function() {
        $('#editTaskModal').on('show.bs.modal', function (event) {
            const button = $(event.relatedTarget);
            $('#edit_task_id').val(button.data('id'));
            $('#edit_task_name').val(button.data('name'));
            $('#edit_task_budget').val(button.data('budget'));
            $('#edit_task_start').val(button.data('start'));
            $('#edit_task_end').val(button.data('end'));
        });

        document.getElementById('editTaskForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const alertContainer = document.getElementById('edit-task-alert');
            alertContainer.innerHTML = '';
            const data = Object.fromEntries(new FormData(this).entries());

            try {
                const response = await fetch(this.action, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                const result = await response.json();
                if (response.ok) { window.location.reload(); }
                else { alertContainer.innerHTML = `<div class="alert alert-danger m-3">${result.error}</div>`; }
            } catch (err) {
                alertContainer.innerHTML = `<div class="alert alert-danger m-3">Erreur serveur.</div>`;
            }
        });
    });
</script>
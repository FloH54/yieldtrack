<div class="modal fade" id="editUserModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog-centered modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Edit User</h4>
                <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div id="edit-user-alert"></div>
            <form action="/users/update" id="editUserForm" method="POST">
                <input type="hidden" name="id" id="edit_user_id">
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6 form-group">
                            <h6>First Name</h6>
                            <input type="text" name="firstName" id="edit_user_firstname" class="form-control" required>
                        </div>
                        <div class="col-md-6 form-group">
                            <h6>Last Name</h6>
                            <input type="text" name="lastName" id="edit_user_lastname" class="form-control" required>
                        </div>
                    </div>
                    <div class="form-group">
                        <h6>Email</h6>
                        <input type="email" name="email" id="edit_user_email" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <h6>Assign Profiles</h6>
                        <select name="profiles" id="edit_user_profiles" class="form-control" multiple style="height: 120px;">
                            <% if (typeof allProfiles !== 'undefined') { %>
                                <% allProfiles.forEach(profile => { %>
                                    <option value="<%= profile.id %>"><%= profile.name %></option>
                                <% }) %>
                            <% } %>
                        </select>
                        <small class="text-muted">Hold Ctrl (Windows) or Command (Mac) to select multiple profiles.</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    $(document).ready(function() {
        // Pré-remplissage de la modale à l'ouverture
        $('#editUserModal').on('show.bs.modal', function (event) {
            const button = $(event.relatedTarget);
            $('#edit_user_id').val(button.data('id'));
            $('#edit_user_firstname').val(button.data('firstname'));
            $('#edit_user_lastname').val(button.data('lastname'));
            $('#edit_user_email').val(button.data('email'));

            // On récupère les IDs des profils stockés dans le bouton (ex: "1,3")
            const profileIds = String(button.data('profiles')).split(',');
            // JQuery gère automatiquement la sélection multiple si on lui passe un tableau de valeurs
            $('#edit_user_profiles').val(profileIds);
            // Pareil pour les units
            const unitIds = String(button.data('units')).split(',');
            $('#edit_user_units').val(unitIds);
        });

        // Soumission du formulaire en AJAX
        document.getElementById('editUserForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const alertContainer = document.getElementById('edit-user-alert');
            alertContainer.innerHTML = '';

            const formData = new FormData(this);
            const data = Object.fromEntries(formData.entries());
            data.profiles = formData.getAll('profiles'); // On récupère bien le tableau des choix multiples
            data.units = formData.getAll('units');

            try {
                const response = await fetch(this.action, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                const contentType = response.headers.get("content-type");

                if (contentType && contentType.indexOf("application/json") !== -1) {
                    const result = await response.json();
                    if (response.ok) {
                        window.location.reload();
                    } else {
                        alertContainer.innerHTML = `<div class="alert alert-danger m-3">${result.error}</div>`;
                    }
                } else {
                    alertContainer.innerHTML = `<div class="alert alert-danger m-3">Erreur Serveur. Vérifiez vos routes.</div>`;
                }
            } catch (err) {
                alertContainer.innerHTML = `<div class="alert alert-danger m-3">Erreur réseau critique : ${err.message}</div>`;
            }
        });
    });
</script>
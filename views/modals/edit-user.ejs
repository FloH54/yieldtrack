<div class="modal fade" id="editUserModal" tabindex="-1" aria-labelledby="editUserModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editUserModalLabel">Edit User</h5>
                <button type="button" class="btn-close" data-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editUserForm">
                    <input type="hidden" id="editUserId" name="id">

                    <div class="mb-3">
                        <label for="editUserFirstName" class="form-label">First Name</label>
                        <input type="text" class="form-control" id="editUserFirstName" name="firstName" required>
                    </div>
                    <div class="mb-3">
                        <label for="editUserLastName" class="form-label">Last Name</label>
                        <input type="text" class="form-control" id="editUserLastName" name="lastName" required>
                    </div>
                    <div class="mb-3">
                        <label for="editUserEmail" class="form-label">Email</label>
                        <input type="email" class="form-control" id="editUserEmail" name="email" required>
                    </div>

                    <div class="mb-3">
                        <label for="editUserProfiles" class="form-label">Profiles</label>
                        <select class="form-control" id="editUserProfiles" name="profiles" multiple>
                            <% allProfiles.forEach(profile => { %>
                                <option value="<%= profile.id || profile.ProfileId || profile.profileId %>"><%= profile.ProfileName || profile.profileName || profile.name %></option>
                            <% }) %>
                        </select>
                        <small class="text-muted">Hold Ctrl/Cmd to select multiple profiles.</small>
                    </div>

                    <div class="mb-3">
                        <label for="editUserUnits" class="form-label">Units (Job)</label>
                        <select class="form-control" id="editUserUnits" name="units" multiple>
                            <% allUnits.forEach(unit => { %>
                                <option value="<%= unit.id || unit.unitId || unit.UnitId %>"><%= unit.unitName || unit.UnitName %></option>
                            <% }) %>
                        </select>
                        <small class="text-muted">Hold Ctrl/Cmd to select multiple units.</small>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="updateUserBtn">Save</button>
            </div>
        </div>
    </div>
</div>

<script>
    // Pre-filling the modal when clicking the button (via jQuery/Bootstrap 4)
    $('#editUserModal').on('show.bs.modal', function (event) {
        var button = $(event.relatedTarget); // The button that triggered the modal

        // We retrieve the data
        var id = button.data('id');
        var firstname = button.data('firstname');
        var lastname = button.data('lastname');
        var email = button.data('email');

        // We transform the ID lists (1,2,3) into arrays (['1', '2', '3'])
        var profiles = button.data('profiles') ? button.data('profiles').toString().split(',') : [];
        var units = button.data('units') ? button.data('units').toString().split(',') : [];

        // We populate the fields
        var modal = $(this);
        modal.find('#editUserId').val(id);
        modal.find('#editUserFirstName').val(firstname);
        modal.find('#editUserLastName').val(lastname);
        modal.find('#editUserEmail').val(email);

        // Automatic filling of multiple selections
        modal.find('#editUserProfiles').val(profiles);
        modal.find('#editUserUnits').val(units);
    });

    // Sending modified data to the server
    document.getElementById('updateUserBtn').addEventListener('click', async () => {
        const form = document.getElementById('editUserForm');
        if (!form.checkValidity()) { form.reportValidity(); return; }

        const formData = new FormData(form);
        const data = Object.fromEntries(formData.entries());

        // Properly retrieve the values of "Multiple Selects"
        const profileSelect = document.getElementById('editUserProfiles');
        data.profiles = Array.from(profileSelect.selectedOptions).map(opt => opt.value);

        const unitSelect = document.getElementById('editUserUnits');
        data.units = Array.from(unitSelect.selectedOptions).map(opt => opt.value);

        try {
            const response = await fetch('/users/update', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });

            const result = await response.json();
            if (response.ok) { window.location.reload(); }
            else { alert('Error: ' + result.error); }
        } catch (error) {
            alert('Server error.');
        }
    });
</script>
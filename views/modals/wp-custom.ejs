<div class="modal fade" id="customWPModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog-centered modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Custom Work Package</h4>
                <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <form action="/create-custom-work-package" method="POST">
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6 form-group">
                            <h6>Work Package Name</h6>
                            <input type="text" name="wpName" class="form-control" required>
                        </div>
                        <div class="col-md-6 form-group">
                            <h6>Slug (URL name)</h6>
                            <input type="text" name="slug" class="form-control" required>
                        </div>
                    </div>

                    <div class="form-group">
                        <h6>Account Number</h6>
                        <input type="text" name="accountNumber" class="form-control" required>
                    </div>

                    <hr>

                    <h6>Resources Needed (Units)</h6>
                    <div class="unit-list mt-3">
                        <% if (typeof units !== 'undefined' && units.length > 0) { %>
                            <% units.forEach(unit => { %>
                                <div class="d-flex align-items-center justify-content-between mb-3 p-2 border-bottom">
                                    <label class="mb-0"><strong><%= unit.unitName %></strong></label>

                                    <div class="d-flex align-items-center">
                                        <button type="button" class="btn btn-sm btn-outline-primary btn-circle"
                                                onclick="updateCounter('<%= unit.unitId %>', -1)">-</button>

                                        <input type="number"
                                               id="unit-qty-<%= unit.unitId %>"
                                               name="units[<%= unit.unitId %>]"
                                               value="0"
                                               min="0"
                                               class="form-control mx-2 text-center"
                                               style="width: 60px;">

                                        <button type="button" class="btn btn-sm btn-outline-primary btn-circle"
                                                onclick="updateCounter('<%= unit.unitId %>', 1)">+</button>
                                    </div>
                                </div>
                            <% }) %>
                        <% } else { %>
                            <p class="text-muted italic">No units available. Please configure units in settings first.</p>
                        <% } %>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create Work Package</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    // Fonction unique pour gérer tous les compteurs par ID d'unité
    function updateCounter(unitId, change) {
        const input = document.getElementById('unit-qty-' + unitId);
        let newValue = parseInt(input.value) + change;
        if (newValue < 0) newValue = 0;
        input.value = newValue;
    }
</script>
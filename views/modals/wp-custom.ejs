<div class="modal fade" id="customWPModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog-centered modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">New Work Package</h4>
                <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div id="alert-container"></div>
            <form action="/wp/create" id="customWPForm" method="POST">
                <input type="hidden" name="projectId" value="<%= project.id %>">
                <input type="hidden" name="projectSlug" value="<%= project.slug %>">
                <input type="hidden" name="fatherWPId" value="<%= typeof parentWP !== 'undefined' ? parentWP.id : '' %>">
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6 form-group">
                            <h6>Work Package Name</h6>
                            <input type="text" name="wpName" id="wp_name" class="form-control" required>
                        </div>
                    </div>

                    <div class="form-group">
                        <h6>Start Date</h6>
                        <input type="date" name="startDate" id="start_date" class="form-control">
                        <br>
                        <h6>End Date</h6>
                        <input type="date" name="endDate" id="end_date" class="form-control">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create Work Package</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const form = document.getElementById('customWPForm');
        const nameInput = document.getElementById('wp_name');
        const startInput = document.getElementById('start_date');
        const endInput = document.getElementById('end_date');
        const alertContainer = document.getElementById('alert-container');

        nameInput.addEventListener('input', function() {
            const slug = this.value
                .toLowerCase()
                .normalize("NFD").replace(/[\u0300-\u036f]/g, "")
                .replace(/[^a-z0-9]/g, '-')
                .replace(/-+/g, '-')
                .replace(/^-|-$/g, '');
            slugInput.value = slug;
        });

        startInput.addEventListener('change', function() {
            endInput.min = this.value;
            if (endInput.value && endInput.value < this.value) {
                endInput.value = this.value;
            }
        });

        form.addEventListener('submit', async function(e) {
            e.preventDefault();
            alertContainer.innerHTML = '';

            const formData = new FormData(this);
            const data = Object.fromEntries(formData.entries());

            try {
                const response = await fetch(this.action, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });

                const result = await response.json();

                if (response.ok) {
                    window.location.href = result.redirect;
                } else {
                    alertContainer.innerHTML = `
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="fas fa-exclamation-triangle mr-2"></i> ${result.error}
                        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                `;
                }
            } catch (err) {
                console.error("Network error:", err);
                // Translated to English
                alertContainer.innerHTML = `<div class="alert alert-danger">Server connection error.</div>`;
            }
        });
    });
</script>
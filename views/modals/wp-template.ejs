<div class="modal fade" id="createWpFromTemplateModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title font-weight-bold"><i class="fas fa-copy mr-2"></i>Charger un Template</h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body p-4">
                <form id="templateWpForm">
                    <input type="hidden" name="projectId" value="<%= project.id %>">
                    <input type="hidden" name="projectSlug" value="<%= project.slug %>">

                    <div class="mb-4">
                        <label class="form-label font-weight-bold text-gray-800">Nom du nouveau WP <span class="text-danger">*</span></label>
                        <input type="text" class="form-control bg-light border-0" name="wpName" required>
                    </div>

                    <div class="mb-3 p-3 bg-white border-left-primary shadow-sm rounded">
                        <label class="form-label font-weight-bold text-primary"><i class="fas fa-building mr-1"></i> Corporate Templates (Officiels)</label>
                        <select class="form-control bg-light border-0" id="corporateSelect">
                            <option value="" selected>-- Aucun --</option>
                            <% templateProjects.filter(p => p.projectTypeId === 1).forEach(proj => { %>
                                <optgroup label="<%= proj.projectName %>">
                                    <% if(proj.workPackages && proj.workPackages.length > 0) { %>
                                        <% proj.workPackages.forEach(wp => { %>
                                            <option value="<%= wp.id %>"><%= wp.wpName %></option>
                                        <% }) %>
                                    <% } %>
                                </optgroup>
                            <% }) %>
                        </select>
                    </div>

                    <div class="text-center font-weight-bold text-gray-500 mb-3">OU</div>

                    <div class="mb-4 p-3 bg-white border-left-success shadow-sm rounded">
                        <label class="form-label font-weight-bold text-success"><i class="fas fa-users mr-1"></i> Templates & Productions (Équipes)</label>
                        <select class="form-control bg-light border-0" id="standardSelect">
                            <option value="" selected>-- Aucun --</option>
                            <% templateProjects.filter(p => p.projectTypeId === 2 || p.projectTypeId === 3).forEach(proj => { %>
                                <optgroup label="<%= proj.projectName %> (<%= proj.projectTypeId === 2 ? 'Template' : 'Production' %>)">
                                    <% if(proj.workPackages && proj.workPackages.length > 0) { %>
                                        <% proj.workPackages.forEach(wp => { %>
                                            <option value="<%= wp.id %>"><%= wp.wpName %></option>
                                        <% }) %>
                                    <% } %>
                                </optgroup>
                            <% }) %>
                        </select>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label font-weight-bold text-gray-800">Date de début</label>
                            <input type="date" class="form-control bg-light border-0" name="startDate">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label font-weight-bold text-gray-800">Date de fin</label>
                            <input type="date" class="form-control bg-light border-0" name="endDate">
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Annuler</button>
                <button type="button" class="btn btn-info px-4 shadow-sm" id="saveWpTemplateBtn">Générer le WP</button>
            </div>
        </div>
    </div>
</div>

<script>
    const corpSelect = document.getElementById('corporateSelect');
    const stdSelect = document.getElementById('standardSelect');

    // Si on choisit un Corporate, on vide le standard
    corpSelect.addEventListener('change', function() {
        if (this.value !== "") stdSelect.value = "";
    });

    // Si on choisit un Standard/Production, on vide le corporate
    stdSelect.addEventListener('change', function() {
        if (this.value !== "") corpSelect.value = "";
    });

    // À la soumission
    document.getElementById('saveWpTemplateBtn').addEventListener('click', async () => {
        const form = document.getElementById('templateWpForm');
        if (!form.checkValidity()) { form.reportValidity(); return; }

        // Vérification : L'utilisateur doit avoir sélectionné au moins un template
        const selectedWpId = corpSelect.value || stdSelect.value;
        if (!selectedWpId) {
            alert("Veuillez choisir un template source (Corporate OU Standard).");
            return;
        }

        const formData = new FormData(form);
        const data = Object.fromEntries(formData.entries());

        // On ajoute manuellement l'ID du template sélectionné
        data.sourceWpId = selectedWpId;

        try {
            const response = await fetch('/wp/create-from-template', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });

            const result = await response.json();
            if (response.ok) { window.location.reload(); }
            else { alert('Erreur: ' + result.error); }
        } catch (error) { alert('Erreur serveur.'); }
    });
</script>
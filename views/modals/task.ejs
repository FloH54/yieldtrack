<div class="modal fade" id="taskModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog-centered modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">New Task</h4>
                <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div id="alert-container"></div>
            <form action="/task/create" id="taskForm" method="POST">
                <input type="hidden" name="wpId" value="<%= (typeof wp !== 'undefined' && wp) ? wp.id : '' %>">
                <input type="hidden" name="wpSlug" value="<%= (typeof wp !== 'undefined' && wp) ? wp.slug : '' %>">
                <input type="hidden" name="projectSlug" value="<%= (typeof projectSlug !== 'undefined' && projectSlug) ? projectSlug : '' %>">

                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6 form-group">
                            <h6>Task Name</h6>
                            <input type="text" name="taskName" id="task_name" class="form-control" required>
                        </div>
                        <div class="col-md-6 form-group">
                            <h6>Budget (in hours)</h6>
                            <input type="text" name="budget" id="task_budget" class="form-control" required>
                        </div>
                    </div>

                    <div class="form-group">
                        <h6>Choose a unit</h6>
                        <input type="text"
                               name="unitNameDisplay"
                               id="unitSearch"
                               class="form-control"
                               list="unitsOptions"
                               placeholder="Start typing a unit name..."
                               required>

                        <datalist id="unitsOptions">
                            <% if (typeof allUnits !== 'undefined' && allUnits) { %>
                                <% allUnits.forEach(unit => { %>
                                    <option value="<%= unit.unitName %>" data-id="<%= unit.unitId %>"></option>
                                <% }) %>
                            <% } %>
                        </datalist>

                        <input type="hidden" name="unitId" id="unitId">
                    </div>

                    <div class="form-group">
                        <h6>Start Date</h6>
                        <input type="date" name="startDate" id="start_date" class="form-control" required>
                        <br>
                        <h6>End Date</h6>
                        <input type="date" name="endDate" id="end_date" class="form-control" required>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create Task</button>
                </div>
            </form>
            </div>
        </div>
    </div>
</div>


</div>




<script>
    document.addEventListener('DOMContentLoaded', function() {
        const form = document.getElementById('taskForm');
        const unitSearch = document.getElementById('unitSearch');
        const unitIdInput = document.getElementById('unitId');
        const options = document.querySelectorAll('#unitsOptions option');
        const startInput = document.getElementById('start_date');
        const endInput = document.getElementById('end_date');
        const alertContainer = document.getElementById('alert-container');


        unitSearch.addEventListener('input', function() {
            const val = this.value;
            unitIdInput.value = ""; // Reset par défaut

            // On cherche si la valeur saisie correspond à une option pour récupérer l'ID
            options.forEach(option => {
                if (option.value === val) {
                    unitIdInput.value = option.getAttribute('data-id');
                }
            });
        });

        startInput.addEventListener('change', function() {
            endInput.min = this.value;
            if (endInput.value && endInput.value < this.value) {
                endInput.value = this.value;
            }
        });

        // SOUMISSION AJAX (FETCH) ET ALERTES
        form.addEventListener('submit', async function(e) {
            e.preventDefault(); // BLOQUE LE RECHARGEMENT DE PAGE
            alertContainer.innerHTML = ''; // Nettoyer les anciennes erreurs

            const formData = new FormData(this);
            const data = Object.fromEntries(formData.entries());

            try {
                const response = await fetch(this.action, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });

                const result = await response.json();

                if (response.ok) {
                    // Si succès (200), on redirige via JS
                    window.location.href = result.redirect;
                } else {
                    // Si erreur (400, 500), on affiche l'alerte sans quitter la modale
                    alertContainer.innerHTML = `
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="fas fa-exclamation-triangle mr-2"></i> ${result.error}
                        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                `;
                }
            } catch (err) {
                console.log("Erreur réseau :", err);
                alertContainer.innerHTML = `<div class="alert alert-danger">Erreur de connexion au serveur.</div>`;
            }
        });
    });
</script>
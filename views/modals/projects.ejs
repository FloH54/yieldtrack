<div class="modal fade" id="projectModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog-centered modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">New Project</h4>
                <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div id="alert-container"></div>
            <form id="projectForm">
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6 form-group">
                            <h6>Project Name</h6>
                            <input type="text" name="projectName" id="proj_name" class="form-control" required>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Project Manager</label>
                        <select id="project-manager" class="form-control" >
                            <option value="">-- Select a Manager --</option>
                            <% if (typeof managers !== 'undefined') { %>
                                <% managers.forEach(manager => { %>
                                    <option value="<%= manager.id || manager.userId %>"><%= manager.firstName || manager.UserFirstName %> <%= manager.lastName || manager.UserLastName %></option>
                                <% }) %>
                            <% } %>
                        </select>
                    </div>

                    <div class="form-group">
                        <h6>Start Date</h6>
                        <input type="date" name="startDate" id="start_date" class="form-control">
                        <br>
                        <h6>End Date</h6>
                        <input type="date" name="endDate" id="end_date" class="form-control">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create Project</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    // On cible le bon ID de formulaire : #projectForm
    $('#projectForm').on('submit', async function(e) {
        e.preventDefault();

        // On cible les bons IDs des inputs définis dans votre HTML
        const data = {
            projectName: $('#proj_name').val(),
            managerId: $('#project-manager').val(),
            startDate: $('#start_date').val(),
            endDate: $('#end_date').val()
        };

        const submitBtn = $(this).find('button[type="submit"]');
        submitBtn.prop('disabled', true).text('Creating...');

        try {
            const response = await fetch('/project/create', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });

            const result = await response.json();

            if (response.ok) {
                window.location.href = result.redirect || '/project';
            } else {
                alert("Error: " + (result.error || "Unknown error occurred."));
                submitBtn.prop('disabled', false).text('Create Project');
            }
        } catch (err) {
            console.error(err);
            alert("Network error or Server unreachable.");
            submitBtn.prop('disabled', false).text('Create Project');
        }
    });
</script>